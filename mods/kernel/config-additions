# Audio: LPASS "bypass" path (lpass-apq8016 + msm8916 WCD digital/analog codec)
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_LPASS_CPU=m
CONFIG_SND_SOC_LPASS_APQ8016=m
CONFIG_SND_SOC_APQ8016_SBC=m
CONFIG_SND_SOC_MSM8916_WCD_ANALOG=m
CONFIG_SND_SOC_MSM8916_WCD_DIGITAL=m
CONFIG_SND_SOC_AW8738=m
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=m
# Battery/charger: bq27500 fuel gauge (real %), SMB358 charger
CONFIG_BATTERY_BQ27XXX=m
CONFIG_BATTERY_BQ27XXX_I2C=m
CONFIG_CHARGER_SMB347=m
# Sensors: BMA223 accelerometer (auto-rotate), AK09911 magnetometer
CONFIG_BMC150_ACCEL=m
CONFIG_BMC150_ACCEL_I2C=m
CONFIG_AK8975=m
# Camera module power for sensor identification (mods/kernel/0003)
CONFIG_YT3_CAM_POWER=m
# ELAN EPL2102 ambient light sensor (mods/kernel/0006)
CONFIG_EPL2102=m
