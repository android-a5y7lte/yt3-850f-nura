+	/*
+	 * Two AW8736 speaker amplifiers fed from HPH_L/HPH_R. Enable GPIOs 16/17
+	 * were found on the device; Lenovo's msm8x16.c (EXT_PA_AW8736) drives
+	 * them with the 2-pulse mode sequence.
+	 */
+	speaker_amp_left: audio-amplifier-left {
+		compatible = "awinic,aw8738";
+		pinctrl-0 = <&spk_ext_pa_left_default>;
+		pinctrl-names = "default";
+		mode-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
+		sound-name-prefix = "Speaker Amp L";
+		awinic,mode = <2>;
+	};
+
+	speaker_amp_right: audio-amplifier-right {
+		compatible = "awinic,aw8738";
+		pinctrl-0 = <&spk_ext_pa_right_default>;
+		pinctrl-names = "default";
+		mode-gpios = <&tlmm 17 GPIO_ACTIVE_HIGH>;
+		sound-name-prefix = "Speaker Amp R";
+		awinic,mode = <2>;
+	};
+
 	camera-power {
