+/*
+ * Scratch buffer for the two-step rotated blend below. The compositor is
+ * single-threaded and renders one pass at a time, so a single buffer that
+ * only grows is enough and avoids a large malloc/page-fault per draw.
+ */
+static uint32_t *rot_scratch;
+static size_t rot_scratch_size;
+
+static pixman_image_t *get_rot_scratch(int width, int height) {
+	size_t need = (size_t)width * (size_t)height * 4;
+	if (need > rot_scratch_size) {
+		uint32_t *data = realloc(rot_scratch, need);
+		if (data == NULL) {
+			return NULL;
+		}
+		rot_scratch = data;
+		rot_scratch_size = need;
+	}
+	return pixman_image_create_bits(PIXMAN_a8r8g8b8, width, height,
+		rot_scratch, width * 4);
+}
+
+static bool is_exact_rotation(enum wl_output_transform transform) {
+	return transform == WL_OUTPUT_TRANSFORM_90 ||
+		transform == WL_OUTPUT_TRANSFORM_180 ||
+		transform == WL_OUTPUT_TRANSFORM_270;
+}
