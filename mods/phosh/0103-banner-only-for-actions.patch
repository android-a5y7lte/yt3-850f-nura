Subject: [PATCH] YT3-850F: only pop up notification banners that need an answer

Plain notifications are shown in the top-bar ticker instead; the banner
window stays for notifications with buttons (accept/reply...) or critical ones.
---
--- a/src/shell.c	2026-11-20 08:21:39.705984050 +0200
+++ b/src/shell.c	2026-11-20 08:21:39.751543118 +0200
@@ -722,6 +722,26 @@
 
   /* Clear existing banner */
   g_clear_pointer (&priv->notification_banner, phosh_cp_widget_destroy);
+
+  /* YT3-850F: notifications go to the top-bar ticker. Only pop up the
+   * banner window when the notification needs an answer (has buttons
+   * besides the default click action) or is critical. */
+  {
+    GStrv actions = phosh_notification_get_actions (notification);
+    gboolean needs_answer = FALSE;
+
+    for (int i = 0; actions && actions[i] && actions[i + 1]; i += 2) {
+      if (g_strcmp0 (actions[i], "default") != 0) {
+        needs_answer = TRUE;
+        break;
+      }
+    }
+    if (phosh_notification_get_urgency (notification) == PHOSH_NOTIFICATION_URGENCY_CRITICAL)
+      needs_answer = TRUE;
+    if (!needs_answer)
+      return;
+  }
+
   if (phosh_notify_manager_get_show_notification_banner (manager, notification) &&
       phosh_top_panel_get_state (PHOSH_TOP_PANEL (priv->top_panel)) == PHOSH_TOP_PANEL_STATE_FOLDED &&
       !priv->locked) {
