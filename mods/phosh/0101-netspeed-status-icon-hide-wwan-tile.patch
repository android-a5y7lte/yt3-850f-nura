@@ -0,0 +1,112 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Current weather in the top bar (YT3-850F port).
+ * yt3-weather.timer writes "<temperature>|<condition>" (from wttr.in) to
+ * /run/yt3-weather/now every 30 minutes; this shows an icon + temperature.
+ */
+
+#include "weather-status-icon.h"
+
+#include <string.h>
+
+#define WEATHER_FILE "/run/yt3-weather/now"
+#define INTERVAL     60
+
+struct _PhoshWeatherStatusIcon {
+  PhoshStatusIcon parent;
+  GtkLabel       *label;
+  guint           timeout_id;
+};
+
+G_DEFINE_TYPE (PhoshWeatherStatusIcon, phosh_weather_status_icon, PHOSH_TYPE_STATUS_ICON);
+
+
+static const char *
+condition_to_icon (const char *cond)
+{
+  g_autofree char *c = g_ascii_strdown (cond, -1);
+
+  if (strstr (c, "thunder") || strstr (c, "storm"))
+    return "weather-storm-symbolic";
+  if (strstr (c, "snow") || strstr (c, "sleet") || strstr (c, "ice") || strstr (c, "blizzard"))
+    return "weather-snow-symbolic";
+  if (strstr (c, "rain") || strstr (c, "drizzle") || strstr (c, "shower"))
+    return "weather-showers-symbolic";
+  if (strstr (c, "fog") || strstr (c, "mist") || strstr (c, "haze"))
+    return "weather-fog-symbolic";
+  if (strstr (c, "overcast") || g_str_equal (c, "cloudy"))
+    return "weather-overcast-symbolic";
+  if (strstr (c, "cloud"))
+    return "weather-few-clouds-symbolic";
+  if (strstr (c, "sun") || strstr (c, "clear"))
+    return "weather-clear-symbolic";
+  return "weather-few-clouds-symbolic";
+}
+
+
+static gboolean
+on_timeout (gpointer data)
+{
+  PhoshWeatherStatusIcon *self = PHOSH_WEATHER_STATUS_ICON (data);
+  g_autofree char *contents = NULL;
+  g_auto (GStrv) parts = NULL;
+  char *temp;
+
+  if (!g_file_get_contents (WEATHER_FILE, &contents, NULL, NULL) ||
+      !(parts = g_strsplit (g_strstrip (contents), "|", 2)) ||
+      !parts[0] || !*parts[0]) {
+    gtk_widget_set_visible (GTK_WIDGET (self), FALSE);
+    return G_SOURCE_CONTINUE;
+  }
+
+  /* "+18°C" -> "18°" */
+  temp = parts[0];
+  if (*temp == '+')
+    temp++;
+  if (g_str_has_suffix (temp, "C") || g_str_has_suffix (temp, "F"))
+    temp[strlen (temp) - 1] = '\0';
+
+  gtk_label_set_text (self->label, temp);
+  phosh_status_icon_set_icon_name (PHOSH_STATUS_ICON (self),
+                                   condition_to_icon (parts[1] ? parts[1] : ""));
+  phosh_status_icon_set_info (PHOSH_STATUS_ICON (self), parts[1]);
+  gtk_widget_set_visible (GTK_WIDGET (self), TRUE);
+
+  return G_SOURCE_CONTINUE;
+}
+
+
+static void
+phosh_weather_status_icon_dispose (GObject *object)
+{
+  PhoshWeatherStatusIcon *self = PHOSH_WEATHER_STATUS_ICON (object);
+
+  g_clear_handle_id (&self->timeout_id, g_source_remove);
+
+  G_OBJECT_CLASS (phosh_weather_status_icon_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_weather_status_icon_class_init (PhoshWeatherStatusIconClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->dispose = phosh_weather_status_icon_dispose;
+
+  gtk_widget_class_set_template_from_resource (widget_class,
+                                               "/mobi/phosh/plugins/weather-status-icon/si.ui");
+  gtk_widget_class_bind_template_child (widget_class, PhoshWeatherStatusIcon, label);
+}
+
+
+static void
+phosh_weather_status_icon_init (PhoshWeatherStatusIcon *self)
+{
+  gtk_widget_init_template (GTK_WIDGET (self));
+
+  self->timeout_id = g_timeout_add_seconds (INTERVAL, on_timeout, self);
+  on_timeout (self);
+}
