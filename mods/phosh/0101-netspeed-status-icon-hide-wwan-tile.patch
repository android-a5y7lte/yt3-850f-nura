+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Live network throughput in the top bar (YT3-850F port).
+ */
+
+#include "status-icon.h"
+
+#pragma once
+
+G_BEGIN_DECLS
+
+#define PHOSH_TYPE_NETSPEED_STATUS_ICON phosh_netspeed_status_icon_get_type ()
+
+G_DECLARE_FINAL_TYPE (PhoshNetspeedStatusIcon,
+                      phosh_netspeed_status_icon,
+                      PHOSH, NETSPEED_STATUS_ICON, PhoshStatusIcon)
+
+G_END_DECLS
