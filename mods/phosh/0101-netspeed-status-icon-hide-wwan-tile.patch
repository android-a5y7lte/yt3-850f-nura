--- /dev/null
+++ b/plugins/netspeed-status-icon/netspeed-status-icon.c
@@ -0,0 +1,135 @@
+/*
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ *
+ * Live network throughput in the top bar (YT3-850F port).
+ * Sums the byte counters of all interfaces except loopback from
+ * /proc/net/dev and shows the download/upload rate.
+ */
+
+#include "netspeed-status-icon.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#define INTERVAL 2
+
+struct _PhoshNetspeedStatusIcon {
+  PhoshStatusIcon parent;
+  GtkLabel       *label;
+  guint           timeout_id;
+  guint64         last_rx;
+  guint64         last_tx;
+  gint64          last_time;
+};
+
+G_DEFINE_TYPE (PhoshNetspeedStatusIcon, phosh_netspeed_status_icon, PHOSH_TYPE_STATUS_ICON);
+
+
+static gboolean
+read_counters (guint64 *rx, guint64 *tx)
+{
+  g_autoptr (FILE) f = NULL;
+  char line[512];
+  int n = 0;
+
+  *rx = *tx = 0;
+  f = fopen ("/proc/net/dev", "r");
+  if (!f)
+    return FALSE;
+
+  while (fgets (line, sizeof (line), f)) {
+    char *colon, *name;
+    unsigned long long r, t, d;
+
+    if (n++ < 2)              /* two header lines */
+      continue;
+    colon = strchr (line, ':');
+    if (!colon)
+      continue;
+    *colon = '\0';
+    name = g_strstrip (line);
+    if (g_str_equal (name, "lo"))
+      continue;
+    /* rx: bytes packets errs drop fifo frame compressed multicast | tx: bytes */
+    if (sscanf (colon + 1, "%llu %llu %llu %llu %llu %llu %llu %llu %llu",
+                &r, &d, &d, &d, &d, &d, &d, &d, &t) != 9)
+      continue;
+    *rx += r;
+    *tx += t;
+  }
+  return TRUE;
+}
+
+
+static char *
+format_rate (double bytes_per_s)
+{
+  if (bytes_per_s >= 1000.0 * 1000.0)
+    return g_strdup_printf ("%.1fM", bytes_per_s / (1000.0 * 1000.0));
+  if (bytes_per_s >= 1000.0)
+    return g_strdup_printf ("%.0fK", bytes_per_s / 1000.0);
+  return g_strdup_printf ("%.0fB", bytes_per_s);
+}
+
+
+static gboolean
+on_timeout (gpointer data)
+{
+  PhoshNetspeedStatusIcon *self = PHOSH_NETSPEED_STATUS_ICON (data);
+  g_autofree char *down = NULL, *up = NULL, *text = NULL;
+  guint64 rx, tx;
+  gint64 now = g_get_monotonic_time ();
+  double secs;
+
+  if (!read_counters (&rx, &tx))
+    return G_SOURCE_CONTINUE;
+
+  if (self->last_time && now > self->last_time && rx >= self->last_rx && tx >= self->last_tx) {
+    secs = (now - self->last_time) / (double) G_USEC_PER_SEC;
+    down = format_rate ((rx - self->last_rx) / secs);
+    up = format_rate ((tx - self->last_tx) / secs);
+    text = g_strdup_printf ("↓%s ↑%s", down, up);
+    gtk_label_set_text (self->label, text);
+  }
+
+  self->last_rx = rx;
+  self->last_tx = tx;
+  self->last_time = now;
+
+  return G_SOURCE_CONTINUE;
+}
+
+
+static void
+phosh_netspeed_status_icon_dispose (GObject *object)
+{
+  PhoshNetspeedStatusIcon *self = PHOSH_NETSPEED_STATUS_ICON (object);
+
+  g_clear_handle_id (&self->timeout_id, g_source_remove);
+
+  G_OBJECT_CLASS (phosh_netspeed_status_icon_parent_class)->dispose (object);
+}
+
+
+static void
+phosh_netspeed_status_icon_class_init (PhoshNetspeedStatusIconClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->dispose = phosh_netspeed_status_icon_dispose;
+
+  gtk_widget_class_set_template_from_resource (widget_class,
+                                               "/mobi/phosh/plugins/netspeed-status-icon/si.ui");
+  gtk_widget_class_bind_template_child (widget_class, PhoshNetspeedStatusIcon, label);
+}
+
+
+static void
+phosh_netspeed_status_icon_init (PhoshNetspeedStatusIcon *self)
+{
+  gtk_widget_init_template (GTK_WIDGET (self));
+
+  self->timeout_id = g_timeout_add_seconds (INTERVAL, on_timeout, self);
+  on_timeout (self);
+}
