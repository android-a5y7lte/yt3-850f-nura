+#include "notifications/notification-list.h"
+#include "notifications/notification.h"
 #include "plugin-loader.h"
 #include "shell-priv.h"
 #include "session-manager.h"
@@ -92,6 +95,12 @@
   GtkWidget *box_top_bar;
   GtkWidget *lbl_clock;      /* top-bar clock */
   GtkWidget *lbl_lang;
+  GtkWidget *notif_indicator;
+  GtkWidget *notif_ticker;
+  GtkWidget *notif_ticker_lbl;
+  guint      notif_ticker_id;
+  int        notif_ticker_pause;
+  GQueue     notif_queue;      /* newest first, refs held */
   PhoshStatusIconsBox *status_icons_box;
 
   GSettings           *custom_status_icons_settings;
@@ -807,6 +816,12 @@
