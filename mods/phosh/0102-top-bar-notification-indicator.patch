   gtk_widget_class_bind_template_child (widget_class, PhoshTopPanel, stack);
@@ -1081,6 +1099,166 @@
 }
 
 
+static void notif_ticker_show (PhoshTopPanel *self, PhoshNotification *notification);
+
+static void
+on_notifications_changed (PhoshTopPanel *self)
+{
+  PhoshNotifyManager *manager = phosh_notify_manager_get_default ();
+  GListModel *list = G_LIST_MODEL (phosh_notify_manager_get_list (manager));
+
+  if (g_list_model_get_n_items (list) > 0)
+    return;
+
+  /* everything cleared: drop the icon and the ticker */
+  g_queue_clear_full (&self->notif_queue, g_object_unref);
+  notif_ticker_show (self, NULL);
+}
+
+
+#define NOTIF_TICKER_STEP_MS  50   /* 20 fps, light on software rendering */
+#define NOTIF_TICKER_STEP_PX  3    /* ~60 px/s */
+#define NOTIF_TICKER_HOLD     30   /* ticks to hold at start/end (~1.5 s) */
+
+static gboolean
+notif_ticker_step (gpointer data)
+{
+  PhoshTopPanel *self = PHOSH_TOP_PANEL (data);
+  GtkAdjustment *adj = gtk_scrolled_window_get_hadjustment (GTK_SCROLLED_WINDOW (self->notif_ticker));
+  double max = gtk_adjustment_get_upper (adj) - gtk_adjustment_get_page_size (adj);
+  double val = gtk_adjustment_get_value (adj);
+
+  if (self->notif_ticker_pause > 0) {
+    self->notif_ticker_pause--;
+    return G_SOURCE_CONTINUE;
+  }
+
+  if (max <= 0) {
+    /* text fits: nothing to slide, stay still */
+    self->notif_ticker_id = 0;
+    return G_SOURCE_REMOVE;
+  }
+
+  if (val >= max) {
+    /* reached the end: jump back and run again */
+    gtk_adjustment_set_value (adj, 0);
+    self->notif_ticker_pause = NOTIF_TICKER_HOLD;
+    return G_SOURCE_CONTINUE;
+  }
+
+  gtk_adjustment_set_value (adj, MIN (val + NOTIF_TICKER_STEP_PX, max));
+  if (val + NOTIF_TICKER_STEP_PX >= max)
+    self->notif_ticker_pause = NOTIF_TICKER_HOLD;
+  return G_SOURCE_CONTINUE;
+}
+
+
+/* Show @notification in the top bar (icon + running text), NULL hides it */
+static void
+notif_ticker_show (PhoshTopPanel *self, PhoshNotification *notification)
+{
+  g_autofree char *text = NULL;
+  g_autofree char *plain_body = NULL;
+  const char *app, *summary, *body;
+  GIcon *icon;
+
+  g_clear_handle_id (&self->notif_ticker_id, g_source_remove);
+
+  if (notification == NULL) {
+    gtk_widget_set_visible (self->notif_ticker, FALSE);
+    gtk_widget_set_visible (self->notif_indicator, FALSE);
+    gtk_image_set_from_icon_name (GTK_IMAGE (self->notif_indicator),
+                                  "preferences-system-notifications-symbolic",
+                                  GTK_ICON_SIZE_MENU);
+    return;
+  }
+
+  app = phosh_notification_get_app_name (notification);
+  summary = phosh_notification_get_summary (notification);
+  body = phosh_notification_get_body (notification);
+  icon = phosh_notification_get_app_icon (notification);
+
+  if (icon)
+    gtk_image_set_from_gicon (GTK_IMAGE (self->notif_indicator), icon, GTK_ICON_SIZE_MENU);
+  else
+    gtk_image_set_from_icon_name (GTK_IMAGE (self->notif_indicator),
+                                  "preferences-system-notifications-symbolic",
+                                  GTK_ICON_SIZE_MENU);
+  gtk_image_set_pixel_size (GTK_IMAGE (self->notif_indicator), 16);
+  gtk_widget_set_visible (self->notif_indicator, TRUE);
+
+  if (body && *body) {
+    /* bodies may carry markup, keep it to one plain line */
+    if (!pango_parse_markup (body, -1, 0, NULL, &plain_body, NULL, NULL))
+      plain_body = g_strdup (body);
+    g_strdelimit (plain_body, "\n\r\t", ' ');
+  }
+
+  text = g_strdup_printf ("%s%s%s%s%s",
+                          (app && *app) ? app : "",
+                          (app && *app) ? ": " : "",
+                          summary ? summary : "",
+                          plain_body ? " — " : "",
+                          plain_body ? plain_body : "");
+
+  gtk_label_set_text (GTK_LABEL (self->notif_ticker_lbl), text);
+  gtk_adjustment_set_value (gtk_scrolled_window_get_hadjustment (GTK_SCROLLED_WINDOW (self->notif_ticker)), 0);
+  gtk_widget_set_visible (self->notif_ticker, *text != '\0');
+
+  /* hold at the start, then slide (only if it doesn't fit), loop until cleared */
+  self->notif_ticker_pause = NOTIF_TICKER_HOLD * 2;
+  if (*text)
+    self->notif_ticker_id = g_timeout_add (NOTIF_TICKER_STEP_MS, notif_ticker_step, self);
+}
+
+
+/* 220px strip in landscape, 140px in portrait so it never crowds the clock */
+static void
+on_top_panel_size_allocate (PhoshTopPanel *self, GdkRectangle *alloc)
+{
+  int want = alloc->width >= 1000 ? 220 : 140;
+  int cur;
+
+  gtk_widget_get_size_request (self->notif_ticker, &cur, NULL);
+  if (cur != want)
+    gtk_widget_set_size_request (self->notif_ticker, want, -1);
+}
+
+
+static void
+on_ticker_notification_closed (PhoshTopPanel *self, PhoshNotificationReason reason, PhoshNotification *notification)
+{
+  GList *link = g_queue_find (&self->notif_queue, notification);
+
+  if (link == NULL)
+    return;
+
+  g_signal_handlers_disconnect_by_data (notification, self);
+  g_queue_delete_link (&self->notif_queue, link);
+  g_object_unref (notification);
+
+  /* fall back to the newest one still around */
+  notif_ticker_show (self, g_queue_peek_head (&self->notif_queue));
+}
+
+
+static void
+on_new_notification (PhoshTopPanel *self, PhoshNotification *notification)
+{
+  if (!g_queue_find (&self->notif_queue, notification)) {
+    g_queue_push_head (&self->notif_queue, g_object_ref (notification));
+    g_signal_connect_object (notification, "closed",
+                             G_CALLBACK (on_ticker_notification_closed),
+                             self, G_CONNECT_SWAPPED);
+  } else {
+    /* updated notification: move it to the front */
+    g_queue_remove (&self->notif_queue, notification);
+    g_queue_push_head (&self->notif_queue, notification);
+  }
+  notif_ticker_show (self, notification);
+}
+
+
 static void
 phosh_top_panel_init (PhoshTopPanel *self)
 {
@@ -1102,6 +1280,19 @@
                            G_CONNECT_SWAPPED);
   on_layout_changed (self, layout_manager);
 
+  g_signal_connect_object (phosh_notify_manager_get_list (phosh_notify_manager_get_default ()),
+                           "items-changed",
+                           G_CALLBACK (on_notifications_changed),
+                           self,
+                           G_CONNECT_SWAPPED);
+  on_notifications_changed (self);
+  g_signal_connect (self, "size-allocate", G_CALLBACK (on_top_panel_size_allocate), NULL);
+  g_signal_connect_object (phosh_notify_manager_get_default (),
+                           "new-notification",
+                           G_CALLBACK (on_new_notification),
+                           self,
+                           G_CONNECT_SWAPPED);
+
   self->custom_status_icons_settings = g_settings_new (CUSTOM_STATUS_ICONS_SCHEMA);
   self->custom_status_icons_loader = phosh_plugin_loader_new ((GStrv) plugin_dirs,
                                                               PHOSH_EXTENSION_POINT_STATUS_ICON_WIDGET);
