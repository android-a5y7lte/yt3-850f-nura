--- a/src/lockscreen.c
+++ b/src/lockscreen.c
@@ -1246,6 +1246,26 @@
 }
 
 
+
+/*
+ * Fallback PIN length for accounts that aren't managed by systemd-homed
+ * (e.g. postmarketOS/Alpine users in /etc/passwd): the length can be put in
+ * /etc/phosh/pin-length so the PIN is submitted as soon as it is complete,
+ * without pressing "Unlock".
+ */
+static int
+read_fallback_pin_length (void)
+{
+  g_autofree char *contents = NULL;
+  gint64 len;
+
+  if (!g_file_get_contents ("/etc/phosh/pin-length", &contents, NULL, NULL))
+    return 0;
+
+  len = g_ascii_strtoll (g_strstrip (contents), NULL, 10);
+  return (len > 0 && len <= 64) ? (int) len : 0;
+}
+
 static void
